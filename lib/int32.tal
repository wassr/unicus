( 32-bit integers use two 16-bit words, high word first. )
( Shift counts and flags are bytes. Addresses are 16-bit words. )
( Arithmetic wraps to 32 bits. Multiplication and division use scratch RAM. )

@int32/add ( ah al bh bl -- ch cl | c = a + b )
    STH2 SWP2 STH2r ( ah bh al bl )
    ADD2k ROT2 ( ah bh bl sum al )
    LTH2k STH POP2 NIP2 ( ah bh sum [carry] )
    ROT2 ROT2 ADD2 #00 STHr ADD2 SWP2 JMP2r

@int32/sub ( ah al bh bl -- ch cl | c = a - b )
    STH2 SWP2 STH2r ( ah bh al bl )
    LTH2k STH SUB2 ( ah bh diff [borrow] )
    ROT2 ROT2 SUB2 #00 STHr SUB2 SWP2 JMP2r

@int32/neg ( ah al -- ch cl | c = -a )
@int32-neg
    int32/not INC2
    DUP2 ORA ?&done
    SWP2 INC2 SWP2
    &done JMP2r

@int32/mul ( ah al bh bl -- ch cl | c = a * b )
@int32-mul
    ,&b-mid STR2 ,&b-high STR2 ,&a-mid STR2 ,&a-high STR2
    ( Cross products contribute only to the high word of the result. )
    ,&a-high LDR2 ,&b-mid LDR2 MUL2
    ,&b-high LDR2 ,&a-mid LDR2 MUL2 ADD2 STH2
    ( Multiply the low words as four byte products, carrying between bytes. )
    #00 ,&a-low LDR #00 ,&b-low LDR MUL2 STH #00 SWP
    #00 ,&a-mid LDR #00 ,&b-low LDR MUL2 ADD2
    DUP2 POP STH NIP #00 SWP
    #00 ,&a-low LDR #00 ,&b-mid LDR MUL2 ADD2
    SWP STH #00 STHr #00 STHr ADD2
    #00 ,&a-mid LDR #00 ,&b-mid LDR MUL2 ADD2
    STHr ROT ROT STH2r ADD2 SWP2 JMP2r
    &a-high $2 &a-mid $1 &a-low $1
    &b-high $2 &b-mid $1 &b-low $1

@int32/udiv ( ah al bh bl -- qh ql | unsigned quotient )
    int32/udivmod POP2 POP2 JMP2r

@int32/sdiv ( ah al bh bl -- qh ql | signed quotient )
    int32/sdivmod POP2 POP2 JMP2r

@int32/umod ( ah al bh bl -- rh rl | unsigned remainder )
    int32/udivmod ROT2 POP2 ROT2 POP2 JMP2r

@int32/smod ( ah al bh bl -- rh rl | signed remainder )
    int32/sdivmod ROT2 POP2 ROT2 POP2 JMP2r

( A zero divisor returns quotient 0 and the original dividend as remainder. )
@int32/udivmod ( ah al bh bl -- qh ql rh rl | unsigned quotient and remainder )
@int32-udivmod
    OVR2 OVR2 int32/is-zero ?&zero-divisor
    ;&divisor int32/store
    OVR2 OVR2 ;&divisor int32/load int32/ult ?&zero-quotient
    OVR2 ORA ?&wide-dividend
    ( Both operands fit in one word after the comparison above. )
    NIP2 ;&divisor INC2 INC2 LDA2 DIV2k
    DUP2 STH2 MUL2 SUB2 STH2r #0000 SWP2 ROT2 #0000 SWP2 JMP2r
    &wide-dividend
    ;&divisor int32/load int32-divisor-top-bit DUP ?&seed
    ( The sole nonzero divisor with its top bit at index zero is 1. )
    POP #0000 #0000 JMP2r
    &seed
    ( Seed the remainder with the leading bits that cannot reach the divisor. )
    STH
    OVR2 OVR2 #20 STHkr SUB int32/ursh ;&remainder int32/store
    STHkr int32/lsh ;&quotient int32/store
    #20 STHr SUB
    &loop
        STH
        ( Move the next dividend bit into the remainder. )
        ;&quotient int32/load OVR2 #0f SFT2 STH2
        int32-lsh-one ;&quotient int32/store
        ;&remainder int32/load int32-lsh-one STH2r ORA2
        ( Subtract when the divisor fits and set the new quotient bit. )
        OVR2 OVR2 ;&divisor int32/load int32/ult ?&save-remainder
        ;&divisor int32/load int32/sub
        ;&quotient INC2 INC2 LDA2k INC2 SWP2 STA2
        &save-remainder
        ;&remainder int32/store
        STHr #01 SUB DUP ?&loop
    POP ;&quotient int32/load ;&remainder int32/load JMP2r
    &zero-divisor POP2 POP2
    &zero-quotient #0000 #0000 ROT2 STH2 ROT2 STH2r JMP2r
    &divisor $4 &quotient $4 &remainder $4

( Truncates toward zero. A nonzero remainder takes the dividend's sign. )
( INT32_MIN / -1 wraps to INT32_MIN with remainder 0. )
@int32/sdivmod ( ah al bh bl -- qh ql rh rl | signed quotient and remainder )
    int32-magnitude STH2 STH2 STH2
    int32-magnitude STH2r STH2r STH2r ( | a-magnitude a-sign b-magnitude b-sign )
    STH2 ROT2 STH2 ( | a-magnitude b-magnitude [b-sign a-sign] )
    int32/udivmod
    STH2r DUP2 STH2r EOR2 ORA STH ( | quotient remainder a-sign [a-sign xor b-sign] )
    ORA int32-neg-if
    ROT2 STH2 ROT2 STH2r STHr int32-neg-if
    ROT2 STH2 ROT2 STH2r JMP2r

@int32/eq ( ah al bh bl -- flag | a = b )
    STH2 SWP2 STH2r EQU2 STH EQU2 STHr AND JMP2r

@int32/is-zero ( ah al -- flag | a = 0 )
    ORA2 #0000 EQU2 JMP2r

@int32/ult ( ah al bh bl -- flag | unsigned a < b )
    STH2 SWP2 STH2r LTH2 STH !int32-compare-high

@int32/slt ( ah al bh bl -- flag | signed a < b )
    STH2 SWP2 STH2r LTH2 STH
    #8000 EOR2 SWP2 #8000 EOR2 SWP2
    ( fall through )

@int32-compare-high ( ah bh [lo-flag] -- flag )
    EQU2k ?&same
    LTH2 POPr JMP2r
    &same POP2 POP2 STHr JMP2r

@int32/and ( ah al bh bl -- ch cl )
    STH2 SWP2 STH2r AND2 STH2 AND2 STH2r JMP2r

@int32/or ( ah al bh bl -- ch cl )
    STH2 SWP2 STH2r ORA2 STH2 ORA2 STH2r JMP2r

@int32/xor ( ah al bh bl -- ch cl )
    STH2 SWP2 STH2r EOR2 STH2 EOR2 STH2r JMP2r

@int32/not ( ah al -- ch cl | bitwise complement )
    #ffff EOR2 SWP2 #ffff EOR2 SWP2 JMP2r

@int32/lsh ( ah al n -- ch cl | c = a << n )
@int32-lsh
    DUP ?&nonzero POP JMP2r
    &nonzero
    DUP #10 LTH ?&subword
    DUP #20 LTH ?&whole-word
    !int32-zero-shift
    &whole-word
    #0f AND #40 SFT STH NIP2 STHr SFT2 #0000 JMP2r
    &subword
    ( Save the left shift control and extract the bits crossing from low to high. )
    DUP #40 SFT STH #10 SWP SUB STH
    DUP2 STHr SFT2
    SWP2 STHkr SFT2 ROT2 STHr SFT2 ROT2 ORA2 SWP2 JMP2r

@int32/ursh ( ah al n -- ch cl | zero-fill right shift )
@int32-ursh
    DUP ?&nonzero POP JMP2r
    &nonzero
    DUP #10 LTH ?&subword
    DUP #20 LTH ?&whole-word
    !int32-zero-shift
    &whole-word
    #0f AND STH POP2 STHr SFT2 #0000 SWP2 JMP2r
    &subword
    ( Save the right shift control and extract the bits crossing from high to low. )
    DUP STH #10 SWP SUB #40 SFT STH
    OVR2 STHr SFT2
    SWP2 ROT2 STHkr SFT2 SWP2 STHr SFT2 ROT2 ORA2 JMP2r

@int32/srsh ( ah al n -- ch cl | sign-extending right shift )
@int32-srsh
    STH OVR2 #8000 AND2 ORA ?&negative
    STHr !int32/ursh
    &negative
        ( Complement before and after the logical shift to fill with ones. )
        int32/not STHr int32/ursh !int32/not

@int32/ufrom16 ( a -- ch cl | zero-extend a )
    #0000 SWP2 JMP2r

@int32/sfrom16 ( a -- ch cl | sign-extend a )
    DUP2 #0f SFT2 #0000 SWP2 SUB2 SWP2 JMP2r

@int32/load ( addr -- ah al | load a big-endian value )
    LDA2k SWP2 INC2 INC2 LDA2 JMP2r

@int32/store ( ah al addr -- | store a big-endian value )
    STH2 STH2kr INC2 INC2 STA2 STH2r STA2 JMP2r

@int32-lsh-one ( ah al -- ch cl )
    DUP2 #0f SFT2 STH2 #10 SFT2
    SWP2 #10 SFT2 STH2r ORA2 SWP2 JMP2r

@int32-divisor-top-bit ( bh bl -- bit | nonzero divisor )
    OVR2 ORA ?&high-word
    NIP2 #00 !&scan
    &high-word POP2 #10
    &scan STH
    ( Reduce the nonzero word to one bit, accumulating the shifts. )
    DUP2 #00ff GTH2 #30 SFT DUP STH SFT2 ADDr
    DUP2 #000f GTH2 #20 SFT DUP STH SFT2 ADDr
    DUP2 #0003 GTH2 #10 SFT DUP STH SFT2 ADDr
    #0001 GTH2 STH ADDr STHr JMP2r

@int32-zero-shift ( ah al n -- zero zero )
    POP POP2 POP2 #0000 #0000 JMP2r

@int32-magnitude ( ah al -- magnitude-hi magnitude-lo sign-word )
    OVR2 #0f SFT2 DUP2 ORA ?&negative
    JMP2r
    &negative STH2 int32/neg STH2r JMP2r

@int32-neg-if ( ah al flag -- ch cl )
    ?int32/neg JMP2r
